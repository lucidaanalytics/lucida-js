{
  "name": "@lucida-analytics/chrome-extension",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Lucida analytics and feature flags for Chrome, Edge and Firefox extensions (Manifest V3): install, update and uninstall tracking, one identity across background, popup and content scripts.",
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "manifest-v3",
    "webextension",
    "analytics",
    "feature-flags",
    "lucida"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucidaanalytics/lucida-js.git",
    "directory": "packages/chrome-extension"
  },
  "homepage": "https://lucidace.com/help/install-chrome-extension",
  "bugs": "https://github.com/lucidaanalytics/lucida-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./page": {
        "types": "./dist/page.d.ts",
        "default": "./dist/page.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucida-analytics/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^9.0.0"
  }
}
