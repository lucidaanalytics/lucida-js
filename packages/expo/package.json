{
  "name": "@lucida-analytics/expo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucidaanalytics/lucida-js.git",
    "directory": "packages/expo"
  },
  "homepage": "https://lucidace.com/help/quickstart",
  "bugs": "https://github.com/lucidaanalytics/lucida-js/issues",
  "description": "Lucida analytics, feature flags and session replay for Expo apps (works in Expo Go; replay in development builds).",
  "keywords": [
    "expo",
    "react-native",
    "analytics",
    "session-replay",
    "feature-flags",
    "lucida"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts",
    "./app.plugin": "./app.plugin.cjs",
    "./app.plugin.js": "./app.plugin.cjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./router": {
        "types": "./dist/router.d.ts",
        "default": "./dist/router.js"
      },
      "./app.plugin": "./app.plugin.cjs",
      "./app.plugin.js": "./app.plugin.cjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "app.plugin.cjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "expo": ">=50",
    "expo-constants": ">=15",
    "expo-application": ">=5",
    "expo-file-system": ">=16",
    "expo-router": ">=3"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@lucida-analytics/react-native": "^0.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsup": "^9.0.0"
  }
}
