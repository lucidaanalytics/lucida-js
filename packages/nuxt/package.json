{
  "name": "@lucida-analytics/nuxt",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/lucidaanalytics/lucida-js.git", "directory": "packages/nuxt" },
  "homepage": "https://lucidace.com/help/quickstart",
  "bugs": "https://github.com/lucidaanalytics/lucida-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime/plugin": "./src/runtime/plugin.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./runtime/plugin": { "types": "./dist/runtime/plugin.d.ts", "default": "./dist/runtime/plugin.js" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucida-analytics/vue": "workspace:*"
  },
  "peerDependencies": {
    "@lucida-analytics/browser": "workspace:^",
    "nuxt": ">=3.8",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "nuxt": { "optional": true }
  },
  "devDependencies": {
    "@lucida-analytics/browser": "workspace:*",
    "@types/node": "^22.0.0",
    "jsdom": "^26.1.0",
    "tsup": "^9.0.0",
    "vue": "^3.5.0"
  }
}
