{
  "name": "@lucida-analytics/next",
  "version": "0.1.5",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/lucidaanalytics/lucida-js.git", "directory": "packages/next" },
  "homepage": "https://github.com/lucidaanalytics/lucida-js/tree/main/packages/next",
  "bugs": "https://github.com/lucidaanalytics/lucida-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.tsx",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
      "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
      "./package.json": "./package.json"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucida-analytics/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "@lucida-analytics/browser": "workspace:^",
    "@lucida-analytics/node": "workspace:^",
    "@lucida-analytics/react": "workspace:^",
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true }
  },
  "devDependencies": {
    "@lucida-analytics/browser": "workspace:*",
    "@lucida-analytics/node": "workspace:*",
    "@lucida-analytics/react": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^9.0.0"
  }
}
