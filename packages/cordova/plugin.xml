<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android"
        id="@lucida-analytics/cordova" version="0.1.0">
  <name>Lucida</name>
  <description>Lucida analytics, feature flags and session replay (bridges the native Lucida iOS and Android SDKs)</description>
  <license>Apache-2.0</license>
  <engines>
    <engine name="cordova" version=">=11.0.0"/>
    <engine name="cordova-android" version=">=12.0.0"/>
    <engine name="cordova-ios" version=">=7.0.0"/>
  </engines>

  <js-module src="www/lucida.js" name="Lucida">
    <clobbers target="cordova.plugins.lucida"/>
  </js-module>

  <platform name="android">
    <preference name="GradlePluginKotlinEnabled" value="true"/>
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="Lucida">
        <param name="android-package" value="com.lucida.cordova.LucidaCordova"/>
        <param name="onload" value="false"/>
      </feature>
    </config-file>
    <source-file src="src/android/LucidaCordova.kt" target-dir="app/src/main/kotlin/com/lucida/cordova"/>
    <source-file src="src/android/Json.kt" target-dir="app/src/main/kotlin/com/lucida/cordova"/>
    <framework src="io.github.lucidaanalytics:lucida-android:0.1.0"/>
  </platform>

  <platform name="ios">
    <config-file target="config.xml" parent="/*">
      <feature name="Lucida">
        <param name="ios-package" value="LucidaCordova"/>
        <param name="onload" value="false"/>
      </feature>
    </config-file>
    <source-file src="src/ios/LucidaCordova.swift"/>
    <source-file src="src/ios/LucidaJson.swift"/>
    <preference name="deployment-target" value="15.0"/>
    <podspec>
      <config><source url="https://cdn.cocoapods.org/"/></config>
      <pods use-frameworks="true">
        <!-- Lucida.podspec sits at the root of github.com/lucidaanalytics/lucida-ios (mirror of sdks/ios), tag 0.1.0 -->
        <pod name="Lucida" git="https://github.com/lucidaanalytics/lucida-ios.git" tag="0.1.0"/>
      </pods>
    </podspec>
  </platform>
</plugin>
