{
  "name": "@lucida-analytics/node",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/lucidaanalytics/lucida-js.git", "directory": "packages/node" },
  "homepage": "https://github.com/lucidaanalytics/lucida-js/tree/main/packages/node",
  "bugs": "https://github.com/lucidaanalytics/lucida-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./middleware": "./src/middleware.ts", "./package.json": "./package.json" },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./middleware": { "types": "./dist/middleware.d.ts", "default": "./dist/middleware.js" },
      "./package.json": "./package.json"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucida-analytics/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0"
  }
}
